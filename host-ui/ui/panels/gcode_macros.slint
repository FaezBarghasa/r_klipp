import { Theme } from "../themes/material_dark.slint";
import { BasePanel } from "../components/base_panel.slint";
import { Button, ScrollView } from "std-widgets.slint";

export struct MacroItem {
    name: string,
    description: string,
}

export component GCodeMacrosPanel inherits BasePanel {
    title: "G-Code Macros";

    in-out property <[MacroItem]> macros: [
        { name: "CANCEL_PRINT", description: "Cancels the active print job" },
        { name: "PAUSE", description: "Pauses the active print job" },
        { name: "RESUME", description: "Resumes the paused print job" },
        { name: "START_PRINT", description: "Initializes nozzle/bed temp and homes axes" },
        { name: "END_PRINT", description: "Turns off heaters and moves nozzle away" }
    ];

    in-out property <bool> sort-reverse: false;

    callback run-macro(string);
    callback toggle-sort();

    VerticalLayout {
        padding: 15px;
        spacing: 15px;

        // Topbar
        HorizontalLayout {
            spacing: 15px;
            height: 45px;
            
            Button {
                text: "Sort: " + (root.sort-reverse ? "Z-A" : "A-Z");
                clicked => { root.sort-reverse = !root.sort-reverse; root.toggle-sort(); }
            }
        }

        // Macro list
        ScrollView {
            VerticalLayout {
                spacing: 10px;
                
                for macro in root.macros : Rectangle {
                    background: Theme.panel-bg;
                    border-radius: 5px;
                    height: 70px;
                    
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 15px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            Text { text: macro.name; font-size: 16px; color: Theme.text; font-weight: 700; }
                            Text { text: macro.description; font-size: 12px; color: Theme.accent; }
                        }

                        Button {
                            text: "Run";
                            clicked => { root.run-macro(macro.name); }
                        }
                    }
                }
            }
        }
    }
}
