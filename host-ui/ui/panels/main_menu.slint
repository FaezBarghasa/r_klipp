import { Theme } from "../themes/material_dark.slint";
import { BasePanel } from "../components/base_panel.slint";
import { Keypad } from "../components/keypad.slint";

export component KlipperMenuTile inherits Rectangle {
    in property <image> icon;
    in-out property <string> label;
    in-out property <string> subtitle: "";
    in-out property <brush> accent-color: Theme.accent;
    callback clicked();

    background: touch.pressed ? #3c3c3c : (touch.has-hover ? #323232 : Theme.button-bg);
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.pressed ? root.accent-color : #383838;
    // touch target minimum 72x72 exceeds 48px KlipperScreen tile size
    min-width: 96px;
    min-height: 88px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding: 10px;

        Image {
            source: root.icon;
            width: 32px;
            height: 32px;
            image-fit: contain;
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: #a0a0a0;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}

export component TempPill inherits Rectangle {
    in-out property <string> name: "Hotend";
    in property <image> icon;
    in-out property <float> actual: 0.0;
    in-out property <float> target: 0.0;
    in-out property <brush> highlight: #ff5252;
    in-out property <bool> is-active: false;
    callback clicked();

    background: root.is-active ? #3e3e3e : (touch.has-hover ? #2e2e2e : Theme.panel-bg);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.is-active ? root.highlight : #3a3a3a;
    height: 56px;
    min-width: 96px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                image-fit: contain;
            }

            Text {
                text: root.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: Math.round(root.actual) + "° / " + Math.round(root.target) + "°";
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

export component MainMenuPanel inherits BasePanel {
    title: "Main Menu";
    callback menu-selected(string);
    callback set-heater-target(string, float);

    in-out property <string> active-heater: "";
    in-out property <float> hotend-temp-num: 0.0;
    in-out property <float> hotend-target-num: 0.0;
    in-out property <float> bed-temp-num: 0.0;
    in-out property <float> bed-target-num: 0.0;
    in-out property <float> chamber-temp-num: 0.0;
    in-out property <float> chamber-target-num: 0.0;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        // Top: heater pills (KlipperScreen header row)
        HorizontalLayout {
            spacing: 10px;
            height: 56px;

            TempPill {
                name: "Hotend";
                icon: @image-url("../icons/hotend.svg");
                actual: root.hotend-temp-num;
                target: root.hotend-target-num;
                highlight: #ff5252;
                clicked => { root.active-heater = "extruder"; }
            }

            TempPill {
                name: "Heater Bed";
                icon: @image-url("../icons/bed.svg");
                actual: root.bed-temp-num;
                target: root.bed-target-num;
                highlight: #448aff;
                clicked => { root.active-heater = "bed"; }
            }

            TempPill {
                name: "Chamber";
                icon: @image-url("../icons/chamber.svg");
                actual: root.chamber-temp-num;
                target: root.chamber-target-num;
                highlight: #ab47bc;
                clicked => { root.active-heater = "chamber"; }
            }
        }

        // Main Area: If a heater is tapped, show the quick Keypad; otherwise show the official KlipperScreen Tile Grid
        if root.active-heater != "" : Rectangle {
            background: Theme.bg;

            VerticalLayout {
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Set Target: " + (root.active-heater == "extruder" ? "Extruder" : (root.active-heater == "bed" ? "Heater Bed" : "Chamber"));
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Keypad {
                    value <=> root.hotend-target-num;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Rectangle {
                        width: 100px;
                        height: 48px;
                        background: Theme.panel-bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.accent;

                        Text { text: "Cancel"; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }

                        TouchArea { clicked => { root.active-heater = ""; } }
                    }

                    Rectangle {
                        width: 100px;
                        height: 48px;
                        background: Theme.accent;
                        border-radius: 6px;

                        Text { text: "Done"; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }

                        TouchArea {
                            clicked => {
                                root.active-heater = "";
                            }
                        }
                    }

                    Rectangle {
                        width: 100px;
                        height: 48px;
                        background: #c62828;
                        border-radius: 6px;

                        Text { text: "Cooldown"; color: #ffffff; vertical-alignment: center; horizontal-alignment: center; }

                        TouchArea {
                            clicked => {
                                root.set-heater-target(root.active-heater, 0.0);
                                root.active-heater = "";
                            }
                        }
                    }
                }
            }
        }

        if root.active-heater == "" : GridLayout {
            spacing: 10px;
            padding-top: 4px;

            // Row 0: Move, Temperature, Extrude, Fan
            Row {
                KlipperMenuTile {
                    icon: @image-url("../icons/move.svg");
                    label: "Move";
                    accent-color: #00ADB5;
                    clicked => { root.menu-selected("move"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/temperature.svg");
                    label: "Temperature";
                    accent-color: #ff5252;
                    clicked => { root.menu-selected("temperature"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/hotend.svg");
                    label: "Extrude";
                    accent-color: #ff8f00;
                    clicked => { root.menu-selected("extrude"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/fan.svg");
                    label: "Fans";
                    accent-color: #448aff;
                    clicked => { root.menu-selected("fan"); }
                }
            }

            // Row 1: Console, Files, Bed Level / Mesh, Z Calibrate
            Row {
                KlipperMenuTile {
                    icon: @image-url("../icons/macros.svg");
                    label: "Console";
                    accent-color: #66bb6a;
                    clicked => { root.menu-selected("console"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/print.svg");
                    label: "Print Files";
                    accent-color: #ffa726;
                    clicked => { root.menu-selected("files"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/level.svg");
                    label: "Bed Level";
                    accent-color: #26c6da;
                    clicked => { root.menu-selected("bed_level"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/tune.svg");
                    label: "Fine Tune";
                    accent-color: #ab47bc;
                    clicked => { root.menu-selected("fine_tune"); }
                }
            }

            // Row 2: Macros, Settings, System, Power
            Row {
                KlipperMenuTile {
                    icon: @image-url("../icons/macros.svg");
                    label: "Macros";
                    accent-color: #7e57c2;
                    clicked => { root.menu-selected("gcode_macros"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/settings.svg");
                    label: "Settings";
                    accent-color: #78909c;
                    clicked => { root.menu-selected("settings"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/system.svg");
                    label: "System";
                    accent-color: #26a69a;
                    clicked => { root.menu-selected("system"); }
                }

                KlipperMenuTile {
                    icon: @image-url("../icons/power.svg");
                    label: "Power";
                    accent-color: #e91e63;
                    clicked => { root.menu-selected("power"); }
                }
            }
        }
    }
}
