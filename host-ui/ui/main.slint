import { ConsolePanel } from "panels/console.slint";
import { FilesPanel } from "panels/files.slint";
import { MovePanel } from "panels/move.slint";
import { TemperaturePanel } from "panels/temperature.slint";
import { MainMenuPanel } from "panels/main_menu.slint";
import { JobStatusPanel } from "panels/job_status.slint";
import { ExtrudePanel } from "panels/extrude.slint";
import { FanPanel, FanDevice } from "panels/fan.slint";
import { BedLevelPanel } from "panels/bed_level.slint";
import { BedMeshPanel } from "panels/bed_mesh.slint";
import { ZCalibratePanel } from "panels/zcalibrate.slint";
import { InputShaperPanel } from "panels/input_shaper.slint";
import { LimitsPanel } from "panels/limits.slint";
import { PressureAdvancePanel } from "panels/pressure_advance.slint";
import { RetractionPanel } from "panels/retraction.slint";
import { FineTunePanel } from "panels/fine_tune.slint";
import { PinsPanel } from "panels/pins.slint";
import { NetworkPanel } from "panels/network.slint";
import { SystemPanel } from "panels/system.slint";
import { SettingsPanel } from "panels/settings.slint";
import { UpdaterPanel } from "panels/updater.slint";
import { PowerPanel } from "panels/power.slint";
import { ShutdownPanel } from "panels/shutdown.slint";
import { CameraPanel } from "panels/camera.slint";
import { SpoolmanPanel } from "panels/spoolman.slint";
import { SpoolEditorPanel } from "panels/spool_editor.slint";
import { GCodeMacrosPanel } from "panels/gcode_macros.slint";
import { ExcludeObjectPanel } from "panels/exclude.slint";
import { LedPanel } from "panels/led.slint";

import {
    MenuItemInfo,
    GCodeFileInfo,
    ConsoleLine,
    ThermalSensor,
    TemperaturePreset,
    FanEntry,
    MacroEntry,
    BedMeshPoint,
    WifiNetwork,
    PowerDevice,
    PackageInfo,
    SpoolInfo,
    AxisPosition,
    PrintStats,
    SystemInfo
} from "types.slint";

import { Theme } from "themes/material_dark.slint";

export {
    ConsolePanel,
    FilesPanel,
    MovePanel,
    TemperaturePanel,
    MainMenuPanel,
    JobStatusPanel,
    ExtrudePanel,
    FanPanel,
    BedLevelPanel,
    BedMeshPanel,
    ZCalibratePanel,
    InputShaperPanel,
    LimitsPanel,
    PressureAdvancePanel,
    RetractionPanel,
    FineTunePanel,
    PinsPanel,
    NetworkPanel,
    SystemPanel,
    SettingsPanel,
    UpdaterPanel,
    PowerPanel,
    ShutdownPanel,
    CameraPanel,
    SpoolmanPanel,
    SpoolEditorPanel,
    GCodeMacrosPanel,
    ExcludeObjectPanel,
    LedPanel,
    MenuItemInfo,
    GCodeFileInfo,
    ConsoleLine,
    ThermalSensor,
    TemperaturePreset,
    FanEntry,
    FanDevice,
    MacroEntry,
    BedMeshPoint,
    WifiNetwork,
    PowerDevice,
    PackageInfo,
    SpoolInfo,
    AxisPosition,
    PrintStats,
    SystemInfo,
    Theme
}

export component AppWindow inherits Window {
    title: "r_klipp";
    width: 800px;
    height: 480px;
    background: Theme.bg;

    // Navigation state
    in-out property <string> active-screen: "main_menu";
    in-out property <string> header-time: "00:00 AM";
    in-out property <string> printer-state: "idle";

    // Telemetry properties
    in-out property <float> nozzle-temp-actual: 0.0;
    in-out property <float> nozzle-temp-target: 0.0;
    in-out property <float> bed-temp-actual: 0.0;
    in-out property <float> bed-temp-target: 0.0;
    in-out property <float> chamber-temp-actual: 0.0;
    in-out property <float> chamber-temp-target: 0.0;

    // Motion properties
    in-out property <float> pos-x: 0.0;
    in-out property <float> pos-y: 0.0;
    in-out property <float> pos-z: 0.0;
    in-out property <float> pos-e: 0.0;
    in-out property <string> homed-axes: "";
    in-out property <float> jog-distance: 10.0;
    in-out property <float> jog-speed: 50.0;

    // Print job properties
    in-out property <float> print-progress: 0.0;
    in-out property <string> current-print-file: "";
    in-out property <int> print-duration-sec: 0;
    in-out property <int> layer-current: 0;
    in-out property <int> layer-total: 0;
    in-out property <float> speed-factor: 1.0;
    in-out property <float> flow-factor: 1.0;

    // Extruder & Fan properties
    in-out property <float> extrude-length: 5.0;
    in-out property <float> extrude-speed: 5.0;
    in-out property <float> fan-speed: 0.0;
    in-out property <[FanDevice]> fans: [
        { name: "Part Cooling Fan", speed: 0.0, changeable: true },
        { name: "Chamber Fan", speed: 0.0, changeable: true },
        { name: "Heatsink Fan", speed: 1.0, changeable: false }
    ];

    // System info properties
    in-out property <string> host-name: "mks-skipr";
    in-out property <string> ip-address: "192.168.1.100";
    in-out property <float> cpu-usage: 0.15;
    in-out property <float> mem-usage: 0.40;
    in-out property <string> mem-text: "1.6 GB / 4.0 GB";

    // Models for lists
    in-out property <[GCodeFileInfo]> gcode-files: [];
    in-out property <[ConsoleLine]> console-lines: [];
    in-out property <[WifiNetwork]> networks: [];

    // Global Callbacks
    callback navigate-to(string);
    callback emergency-stop();
    callback home-axis(string);
    callback jog-axis(string, float, float);
    callback disable-motors();
    callback set-nozzle-target(float);
    callback set-bed-target(float);
    callback set-chamber-target(float);
    callback extrude(float, float);
    callback set-fan-speed(int, float);
    callback start-print(string);
    callback pause-print();
    callback resume-print();
    callback cancel-print();
    callback send-gcode-command(string);
    callback refresh-files();
    callback run-macro(string);
    callback update-package(string);
    callback restart-service(string);
    callback shutdown-system();
    callback reboot-system();

    // Top-level panel router
    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        if root.active-screen == "main_menu" : MainMenuPanel {
            time: root.header-time;
            hotend-temp-num: root.nozzle-temp-actual;
            hotend-target-num: root.nozzle-temp-target;
            bed-temp-num: root.bed-temp-actual;
            bed-target-num: root.bed-temp-target;
            chamber-temp-num: root.chamber-temp-actual;
            chamber-target-num: root.chamber-temp-target;
            menu-selected(panel) => {
                root.active-screen = panel;
                root.navigate-to(panel);
            }
            set-heater-target(heater, temp) => {
                if (heater == "extruder") {
                    root.set-nozzle-target(temp);
                } else if (heater == "bed") {
                    root.set-bed-target(temp);
                } else if (heater == "chamber") {
                    root.set-chamber-target(temp);
                }
            }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "job_status" : JobStatusPanel {
            time: root.header-time;
            filename: root.current-print-file;
            status: root.printer-state;
            progress: root.print-progress;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
            pause-job => { root.pause-print(); }
            resume-job => { root.resume-print(); }
            cancel-job => { root.cancel-print(); }
        }

        if root.active-screen == "move" : MovePanel {
            jog-increment: root.jog-distance;
            jog-move(axis, dist) => {
                root.jog-axis(axis, dist, root.jog-speed);
            }
            home-axis(axis) => { root.home-axis(axis); }
        }

        if root.active-screen == "temperature" : TemperaturePanel {
            extruder-temp: root.nozzle-temp-actual;
            extruder-target: root.nozzle-temp-target;
            bed-temp: root.bed-temp-actual;
            bed-target: root.bed-temp-target;
            set-temperature(device, target) => {
                if device == "extruder" {
                    root.set-nozzle-target(target);
                } else if device == "heater_bed" {
                    root.set-bed-target(target);
                }
            }
        }

        if root.active-screen == "extrude" : ExtrudePanel {
            time: root.header-time;
            hotend-temp: root.nozzle-temp-actual + "";
            hotend-target: root.nozzle-temp-target + "";
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
            extrude(dist, spd) => { root.extrude(dist, spd); }
            retract(dist, spd) => { root.extrude(-dist, spd); }
        }

        if root.active-screen == "fan" : FanPanel {
            time: root.header-time;
            fans: root.fans;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
            fan-speed-changed(fan_name, spd) => {
                root.fan-speed = spd;
                root.set-fan-speed(0, spd);
            }
        }

        if root.active-screen == "files" : FilesPanel {
            gcode-files: root.gcode-files;
            file-action(action, name) => {
                if action == "print" {
                    root.start-print(name);
                } else if action == "back" {
                    root.active-screen = "main_menu";
                }
            }
        }

        if root.active-screen == "console" : ConsolePanel {
            console-lines: root.console-lines;
            send-gcode(cmd) => { root.send-gcode-command(cmd); }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "bed_level" : BedLevelPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "bed_mesh" : BedMeshPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "zcalibrate" : ZCalibratePanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "input_shaper" : InputShaperPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "limits" : LimitsPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "pressure_advance" : PressureAdvancePanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "retraction" : RetractionPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "fine_tune" : FineTunePanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "pins" : PinsPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "network" : NetworkPanel {
            time: root.header-time;
            ip-address: root.ip-address;
            networks: root.networks;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "system" : SystemPanel {
            time: root.header-time;
            hostname: root.host-name;
            cpu-usage: root.cpu-usage;
            memory-usage: root.mem-usage;
            memory-text: root.mem-text;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "settings" : SettingsPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "updater" : UpdaterPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
            update-package(pkg) => { root.update-package(pkg); }
            restart-service(svc) => { root.restart-service(svc); }
        }

        if root.active-screen == "power" : PowerPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "shutdown" : ShutdownPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
            shutdown-clicked => { root.shutdown-system(); }
            reboot-clicked => { root.reboot-system(); }
            restart-ks-clicked => { root.restart-service("klipperscreen"); }
        }

        if root.active-screen == "camera" : CameraPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "spoolman" : SpoolmanPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "spool_editor" : SpoolEditorPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "gcode_macros" : GCodeMacrosPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
            run-macro(name) => { root.run-macro(name); }
        }

        if root.active-screen == "exclude" : ExcludeObjectPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }

        if root.active-screen == "led" : LedPanel {
            time: root.header-time;
            back-clicked => { root.active-screen = "main_menu"; }
            home-clicked => { root.active-screen = "main_menu"; }
            estop-clicked => { root.emergency-stop(); }
        }
    }
}

export component RKlipperScreen inherits AppWindow {}
