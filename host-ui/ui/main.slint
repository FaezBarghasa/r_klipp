import { VerticalBox, HorizontalBox, Button, LineEdit, Switch, ListView, TabWidget } from "std-widgets.slint";

export struct GCodeFile {
    name: string,
    size: string,
    upload_date: string,
}

export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    title: "rKlipperScreen";
    background: #282c34;

    in property <float> nozzle_temp_actual: 0.0;
    in property <float> nozzle_temp_target: 0.0;
    in property <float> bed_temp_actual: 0.0;
    in property <float> bed_temp_target: 0.0;
    in property <float> print_progress: 0.0;
    in property <string> current_print_file: "No file selected";
    in property <[string]> console_output: ["Welcome to rKlipperScreen!"];
    in property <[GCodeFile]> gcode_files: [];

    callback set_nozzle_target(float);
    callback set_bed_target(float);
    callback start_print(string);
    callback refresh_files();
    callback send_gcode_command(string);

    VerticalBox {
        alignment: start;
        spacing: 10px;
        padding: 12px;

        // Header
        HorizontalBox {
            height: 40px;
            alignment: space-between;
            Text {
                text: "r_klipp Touch Screen";
                font-size: 22px;
                color: #61afef;
                font-weight: 700;
            }
            Text {
                text: "Target: 3D / PnP / CNC";
                font-size: 14px;
                color: #98c379;
                vertical-alignment: center;
            }
        }

        // Main Content Area
        HorizontalBox {
            spacing: 12px;

            // Left Panel (Dashboard/Controls)
            Rectangle {
                width: 380px;
                background: #323842;
                border-radius: 8px;

                VerticalBox {
                    padding: 12px;
                    spacing: 10px;

                    Text { text: "Dashboard & Temperatures"; font-size: 16px; color: #abb2bf; font-weight: 600; }

                    // Temperatures
                    HorizontalBox {
                        spacing: 12px;
                        VerticalBox {
                            Text { text: "Nozzle: \{round(root.nozzle_temp_actual)}°C / \{round(root.nozzle_temp_target)}°C"; color: #e06c75; font-size: 14px; }
                            HorizontalBox {
                                spacing: 6px;
                                Button { text: "-5°C"; clicked => { root.set_nozzle_target(root.nozzle_temp_target - 5.0); } }
                                Button { text: "+5°C"; clicked => { root.set_nozzle_target(root.nozzle_temp_target + 5.0); } }
                            }
                        }
                        VerticalBox {
                            Text { text: "Bed: \{round(root.bed_temp_actual)}°C / \{round(root.bed_temp_target)}°C"; color: #98c379; font-size: 14px; }
                            HorizontalBox {
                                spacing: 6px;
                                Button { text: "-5°C"; clicked => { root.set_bed_target(root.bed_temp_target - 5.0); } }
                                Button { text: "+5°C"; clicked => { root.set_bed_target(root.bed_temp_target + 5.0); } }
                            }
                        }
                    }

                    // Print Progress
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "Print Progress: \{round(root.print_progress * 100)}%"; color: #abb2bf; font-size: 14px; }
                        Rectangle {
                            height: 12px;
                            background: #4b5263;
                            border-radius: 6px;
                            Rectangle {
                                x: 0px;
                                width: root.print_progress * parent.width;
                                height: parent.height;
                                background: #61afef;
                                border-radius: 6px;
                            }
                        }
                        Text { text: "File: \{root.current_print_file}"; color: #abb2bf; font-size: 13px; }
                    }

                    // Quick Actions
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: "Home All (G28)"; clicked => { root.send_gcode_command("G28"); } }
                        Button { text: "E-Stop"; clicked => { root.send_gcode_command("M112"); } }
                    }
                }
            }

            // Right Panel (Tabs)
            Rectangle {
                horizontal-stretch: 1;
                background: #323842;
                border-radius: 8px;

                TabWidget {
                    Tab {
                        title: "Files";
                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            HorizontalBox {
                                Button { text: "Refresh Files"; clicked => { root.refresh_files(); } }
                            }
                            ListView {
                                for file in root.gcode_files: HorizontalBox {
                                    spacing: 8px;
                                    Text { text: file.name; color: #ffffff; width: 140px; font-size: 13px; vertical-alignment: center; }
                                    Text { text: file.size; color: #abb2bf; width: 60px; font-size: 12px; vertical-alignment: center; }
                                    Button { text: "Print"; clicked => { root.start_print(file.name); } }
                                }
                            }
                        }
                    }
                    Tab {
                        title: "Console";
                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            ListView {
                                for line in root.console_output: Text {
                                    text: line;
                                    color: #abb2bf;
                                    font-size: 12px;
                                }
                            }
                            HorizontalBox {
                                spacing: 6px;
                                gcode_input := LineEdit {
                                    placeholder-text: "Enter G-code / OpenPnP command";
                                    font-size: 13px;
                                }
                                Button {
                                    text: "Send";
                                    clicked => {
                                        root.send_gcode_command(gcode_input.text);
                                        gcode_input.text = "";
                                    }
                                }
                            }
                        }
                    }
                    Tab {
                        title: "Multi-Target Profile";
                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: "Active Profiles: 3D Printer / PnP / CNC"; color: #ffffff; font-size: 14px; }
                            Text { text: "• CAN-FD Smart Feeders: Active"; color: #98c379; font-size: 12px; }
                            Text { text: "• 5-Axis RTCP Transform: Enabled"; color: #61afef; font-size: 12px; }
                            Text { text: "• TMC2240 Paste StallGuard: Armed"; color: #e5c07b; font-size: 12px; }
                        }
                    }
                }
            }
        }
    }
}
