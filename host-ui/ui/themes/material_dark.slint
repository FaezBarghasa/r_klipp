// Material Dark theme — matches KlipperScreen reference palette exactly
export global Theme {
    in-out property <color> bg:         #121212;
    in-out property <color> active:     #1F3A52;
    in-out property <color> accent:     #00ADB5;
    in-out property <color> text:       #EEEEEE;
    in-out property <color> error:      #CF6679;
    in-out property <color> warning:    #FFB74D;
    in-out property <color> echo:       #4DB6AC;
    in-out property <color> panel-bg:   #1E1E1E;
    in-out property <color> button-bg:  #2D2D2D;
    // extra semantic aliases used across panels
    in-out property <color> hot:        #FF5252;
    in-out property <color> cool:       #448AFF;
    in-out property <color> ok:         #4DB6AC;
    in-out property <color> bar-bg:     #333333;
}
